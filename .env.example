# Database connection for local development PostgreSQL
DATABASE_URL=postgresql://pulse_user:local_password@localhost:5432/pulse_dev_db

POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=local_password
POSTGRES_DB=pulse_dev_db

BCRYPT_ROUNDS=14

# Initial Administrator Seed Configuration (required by npm run db:seed)
# Password must be at least 8 characters and contain letters and numbers/symbols.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@merchantpulse.com"
ADMIN_PASSWORD="password"
